<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#090a0f" />
      <stop offset="100%" stop-color="#12141d" />
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34d399" />
      <stop offset="100%" stop-color="#059669" />
    </linearGradient>
    <filter id="emeraldGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="8" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Background Squircle -->
  <rect width="512" height="512" rx="128" fill="url(#bgGrad)" stroke="#10b981" stroke-width="12" stroke-opacity="0.3" />

  <!-- Master Concept 1: Isometric FR Core (Paul Rand Lineage) -->
  <g id="isometric-fr-core" fill="url(#accentGrad)" filter="url(#emeraldGlow)">
    <!-- Top Face: Distributed Cloud Plane (Rhombus) -->
    <path d="M 256 90 L 386 164 L 256 238 L 126 164 Z" opacity="0.95" />
    
    <!-- Left Face (F Architecture) -->
    <!-- F Spine (Vertical Pillar) -->
    <path d="M 126 184 L 165 206 L 165 400 L 126 378 Z" opacity="0.9" />
    <!-- F Top Arm -->
    <path d="M 180 214 L 246 252 L 246 290 L 180 252 Z" opacity="0.9" />
    <!-- F Middle Arm -->
    <path d="M 180 270 L 228 298 L 228 336 L 180 308 Z" opacity="0.9" />
    <!-- F Lower Foundation Node -->
    <path d="M 180 326 L 246 364 L 246 402 L 180 364 Z" opacity="0.9" />

    <!-- Right Face (R Architecture) -->
    <!-- R Left Vertical Spine -->
    <path d="M 266 252 L 305 230 L 305 424 L 266 402 Z" opacity="0.8" />
    <!-- R Top Loop -->
    <path d="M 320 221 L 386 184 L 386 278 L 320 316 Z" opacity="0.8" />
    <!-- R Diagonal Thrust Leg -->
    <path d="M 320 335 L 386 296 L 386 410 L 320 372 Z" opacity="0.8" />
  </g>
</svg>